# Copy to .env. Loaded only by the Node services in agents/; the browser never sees these.

# NEAR AI Cloud API key (https://cloud.near.ai). Enables model-written copy explanations
# with gateway signature verification. Without it, explanations are template text.
NEARAI_API_KEY=

# NEAR Intents 1Click partner JWT (https://partners.near-intents.org). Optional; without it
# dry quotes still work but carry the default fee and are not confidential.
ONECLICK_PARTNER_JWT=

# NEAR testnet account the demo button signs as. Needs its key in ~/.near-credentials/testnet
# and a few testnet NEAR. Defaults to POLYPUS_FOLLOWER (carol-18e5.testnet).
POLYPUS_DEMO_ACCOUNT=

# Overrides for running against your own deployment (defaults point at the project's testnet accounts)
# POLYPUS_REGISTRY=polypus-keys-18e5.testnet
# POLYPUS_TRADERS=alice-18e5.testnet,bob-18e5.testnet
# POLYPUS_FOLLOWER=carol-18e5.testnet
# POLYPUS_AGENT_OPERATOR=polypus-agent-18e5.testnet
# NEAR_RPC=https://rpc.testnet.fastnear.com
# POLYPUS_RPC=https://api.devnet.solana.com
# POLYPUS_TRADE_MIN_S=60
# POLYPUS_TRADE_MAX_S=90
